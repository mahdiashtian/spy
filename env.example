# =============================================================================
# Telegram Bridge Bot Configuration
# =============================================================================
# This file contains all configuration variables for the Telegram Bridge Bot.
# Copy this file to .env and fill in your actual values.
# NEVER commit .env file to version control (it's in .gitignore)

# =============================================================================
# Telegram API Credentials
# =============================================================================
# Get these from https://my.telegram.org/apps
# 1. Go to https://my.telegram.org/apps
# 2. Log in with your phone number
# 3. Create a new application
# 4. Copy the api_id and api_hash here

API_ID=0
API_HASH=your_api_hash_here

# =============================================================================
# Bot Token
# =============================================================================
# Get this from @BotFather on Telegram
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot command
# 3. Follow the instructions to create your bot
# 4. Copy the bot token here

BOT_TOKEN=your_bot_token_here

# =============================================================================
# Admin Chat ID
# =============================================================================
# This can be:
# - A private user ID (positive number, e.g., 123456789)
# - A group ID (negative number, e.g., -1234567890)
# - A channel ID (negative number with 100 prefix, e.g., -1001234567890)
#
# To get your user ID:
#   - Send a message to @userinfobot on Telegram
#
# To get a group/channel ID:
#   - Add @userinfobot to the group/channel
#   - Or use @getidsbot

ADMIN_CHAT_ID=0

# =============================================================================
# Session Configuration
# =============================================================================
# Session file name (without extension)
# The session file will be created automatically and stored in the project directory

SESSION_NAME=bridge_bot

# =============================================================================
# Optional: Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO

LOG_LEVEL=INFO

# Log file path (relative to project directory)
# Default: bot.log

LOG_FILE=bot.log


# =============================================================================
# Redis Configuration (for blocking system)
# =============================================================================
# Redis connection settings for user blocking/unblocking feature
# Default values work for local Redis installation

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Leave empty if Redis doesn't require password
REDIS_PASSWORD=

# =============================================================================
# Performance & Optimization Settings
# =============================================================================
# Maximum number of message mappings to keep in memory (LRU cache)
# Default: 10000

MAX_MESSAGE_MAPPINGS=10000

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
# Enable/disable rate limiting to prevent spam
# Default: true

RATE_LIMIT_ENABLED=true

# Maximum number of messages allowed per time window
# Default: 10

RATE_LIMIT_MAX_MESSAGES=10

# Time window for rate limiting in seconds
# Default: 60 (1 minute)

RATE_LIMIT_WINDOW=60

# =============================================================================
# Redis Advanced Configuration
# =============================================================================
# Maximum number of Redis connections in pool
# Default: 20

REDIS_MAX_CONNECTIONS=20

# Redis socket timeout in seconds
# Default: 5

REDIS_SOCKET_TIMEOUT=5

# Redis socket connect timeout in seconds
# Default: 5

REDIS_SOCKET_CONNECT_TIMEOUT=5
